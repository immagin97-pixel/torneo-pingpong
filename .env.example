# ==========================================
# VARIABLES DE ENTORNO DEL BACKEND (Express + WebSocket)
# ==========================================

# Puerto en el que escucha el servidor backend (Render/Railway lo asignan automáticamente mediante $PORT)
PORT=3001

# Entorno de ejecución: 'development' o 'production'
NODE_ENV=production

# URL del Frontend en Vercel permitido por CORS (ej: https://mi-torneo-pingpong.vercel.app)
FRONTEND_URL=https://mi-torneo-pingpong.vercel.app

# PIN secreto del Administrador para validar operaciones de escritura (Default: 1234)
ADMIN_PIN=1234

# Directorio del disco persistente donde se guardará tournament_state.json (Ej: /var/data o ./data)
DATA_DIR=./data

# ==========================================
# VARIABLES DE ENTORNO DEL FRONTEND (Vite / Vercel)
# ==========================================

# URL pública del Backend desplegado en Render / Railway (sin barra final)
# En desarrollo local: http://localhost:3001
# En producción Vercel: https://torneo-pingpong-backend.onrender.com
VITE_API_URL=https://torneo-pingpong-backend.onrender.com
