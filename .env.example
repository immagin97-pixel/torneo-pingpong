# ==========================================================
# VARIABLES DE ENTORNO DEL BACKEND (Express + Supabase + WebSockets)
# ==========================================================

# 1. Configuración de Base de Datos Supabase (ÚNICA FUENTE DE VERDAD)
# Obtén estos valores en tu proyecto de Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS...

# 2. Seguridad del Panel de Administración
ADMIN_PIN=1234

# 3. Entorno de Ejecución ('development' o 'production')
NODE_ENV=production

# 4. Puerto de escucha (Render lo inyecta automáticamente con $PORT)
PORT=3001

# 5. URL del Frontend en Vercel permitido por CORS (ej: https://tu-torneo.vercel.app)
FRONTEND_URL=https://tu-torneo.vercel.app

# ==========================================================
# VARIABLES DE ENTORNO DEL FRONTEND (Vite / Vercel)
# ==========================================================

# URL pública de la API Backend en Render (sin barra final)
# En local: http://localhost:3001
# En Vercel: https://torneo-pingpong-backend.onrender.com
VITE_API_URL=https://torneo-pingpong-backend.onrender.com
